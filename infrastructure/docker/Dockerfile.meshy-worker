# Meshy Worker Dockerfile
FROM python:3.12-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN groupadd -g 1000 appgroup && \
    useradd -u 1000 -g appgroup -m appuser

# Install Meshy client dependencies
COPY tools/python/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Install additional mesh processing tools
RUN pip install --no-cache-dir \
    meshoptimizer \
    pygltflib \
    trimesh \
    numpy

COPY infrastructure/docker/entrypoint-meshy.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER appuser

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-m", "scripts.meshy_integration.asset_generator"]