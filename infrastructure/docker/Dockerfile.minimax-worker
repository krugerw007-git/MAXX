# Minimax Worker Dockerfile
FROM python:3.12-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN groupadd -g 1000 appgroup && \
    useradd -u 1000 -g appgroup -m appuser

COPY tools/python/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Install video/audio processing tools
RUN pip install --no-cache-dir \
    moviepy \
    pydub \
    librosa \
    soundfile

COPY infrastructure/docker/entrypoint-minimax.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER appuser

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-m", "scripts.minimax_integration.video_generator"]